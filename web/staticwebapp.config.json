{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/index.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/styles.css",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/login.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/login.js",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/home.js",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "comment": "The claim page is reached by someone with no account at all, following a link out of an email. It must render before there is any session to check.",
      "route": "/claim",
      "rewrite": "/claim.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/claim.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/claim.js",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "comment": "The invitation page is reached the same way the claim page is -- out of an email, by somebody who may have no account. Same anonymous treatment, for the same reason.",
      "route": "/invite",
      "rewrite": "/invite.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/invite.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/invite.js",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "comment": "Managing an archive's audience. Authenticated, and the API refuses anyone who is not an owner of the named slug -- this rule only decides who may load the markup.",
      "route": "/people/*",
      "rewrite": "/people.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "comment": "Help pages, read by people with no account and often before they have decided whether to have one. Anonymous for the same reason the front page is: `/*` below is authenticated, so anything omitted here disappears behind a sign-in.",
      "route": "/start",
      "rewrite": "/start.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/start.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/faq",
      "rewrite": "/faq.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/faq.html",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/favicon.ico",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "comment": "The sign-in chooser is anonymous and shows a provider icon, so the icon font has to be reachable without a session. It carries no archive data.",
      "route": "/vendor/fontawesome/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "comment": "Describing a claim changes nothing and has to answer someone who has not signed in yet -- that is the whole point of the page. It must precede the /api/* rule, which matches first-wins. Redemption is deliberately not listed, so it falls through to authenticated.",
      "route": "/api/claim/describe",
      "methods": ["POST"],
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "comment": "Same as claim/describe: the invitation page has to say who invited whom before anybody signs in. Accepting is not listed, so it falls through to authenticated.",
      "route": "/api/invite/describe",
      "methods": ["POST"],
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/site.html",
    "exclude": [
      "/.auth/*",
      "/api/*",
      "/*.css",
      "/*.js",
      "/*.ico",
      "/*.svg",
      "/*.png",
      "/*.webp",
      "/*.woff2"
    ]
  },
  "responseOverrides": {
    "401": {
      "rewrite": "/login.html"
    }
  },
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/common/v2.0",
          "clientIdSettingName": "AZURE_CLIENT_ID",
          "clientSecretSettingName": "AZURE_CLIENT_SECRET"
        }
      },
      "google": {
        "registration": {
          "clientIdSettingName": "GOOGLE_CLIENT_ID",
          "clientSecretSettingName": "GOOGLE_CLIENT_SECRET"
        }
      }
    }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
    "Permissions-Policy": "geolocation=(), camera=(), microphone=(), interest-cohort=()"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webp": "image/webp"
  }
}
